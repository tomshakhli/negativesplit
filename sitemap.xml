---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for p in site.pages -%}
  {%- if p.sitemap == false or p.layout == 'redirect' -%}{%- continue -%}{%- endif -%}
  {%- if p.url contains '.xml' or p.url contains '.txt' or p.url contains '.css' -%}{%- continue -%}{%- endif %}
  <url>
    <loc>{{ site.url }}{{ p.url }}</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
    <priority>{% if p.url == '/' %}1.0{% elsif p.url == '/marathon/' %}0.9{% else %}0.7{% endif %}</priority>
  </url>
{%- endfor -%}
{%- for n in site.notes %}
  <url>
    <loc>{{ site.url }}{{ n.url }}</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
    <priority>0.6</priority>
  </url>
{%- endfor %}
</urlset>
